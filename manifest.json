{
  "manifest_version": 3,
  "name": "LinkedIn Job Scanner",
  "version": "0.1.0",
  "description": "Compares your resume against the LinkedIn job posting you're viewing: keyword matches, clearance/sponsorship/YOE detection.",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel/dist/index.html"
  },
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
